APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:ergSY/hGE+qiGIX2Vn53MQpebxN1w1AxdWNEThCWFXE=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12


# -------------------------------------------
# Logging
# -------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# -------------------------------------------
# Database
# -------------------------------------------

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_db
DB_USERNAME=root
DB_PASSWORD="SecretPassword123!"


# -------------------------------------------
# Session
# -------------------------------------------

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# -------------------------------------------
# Redis
# -------------------------------------------

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# -------------------------------------------
# Cache
# -------------------------------------------

CACHE_STORE=file


# -------------------------------------------
# Queue
# -------------------------------------------

QUEUE_CONNECTION=sync


# -------------------------------------------
# Broadcasting
# -------------------------------------------

BROADCAST_CONNECTION=log


# -------------------------------------------
# Filesystem
# -------------------------------------------

FILESYSTEM_DISK=local


# -------------------------------------------
# Google Cloud
# -------------------------------------------

GOOGLE_CLOUD_PROJECT_ID=file-sharing-505303
GOOGLE_CLOUD_STORAGE_BUCKET=file-sharing-505303-storage


# -------------------------------------------
# Mail
# -------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# -------------------------------------------
# AWS
# -------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# -------------------------------------------
# Vite
# -------------------------------------------

VITE_APP_NAME="${APP_NAME}"
